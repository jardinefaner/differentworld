<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Camera capture for person avatars. Modern Android (API 33+)
         uses the system Photo Picker which needs no permissions; the
         CAMERA permission is required only when image_picker's source
         is ImageSource.camera. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!-- Voice dictation via Deepgram streaming. The `record` plugin
         needs RECORD_AUDIO at runtime; INTERNET is already implicit
         for debug builds but we declare explicitly here so release
         builds keep it. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:label="differentworld"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <!-- Deep links are handled EXCLUSIVELY by the app_links
                 package (lib/features/invites/deep_link_listener.dart),
                 which translates differentworld://v/<id>/<kind> and
                 differentworld://invite/<code> into the right go_router
                 route via the pending-link providers + the consumers on
                 TodayScreen / the login flow.

                 Flutter 3.24+ turns ON its OWN deep-link routing by
                 default. That handler feeds the RAW custom-scheme URI
                 straight to go_router, which can't match
                 `differentworld://v/...` to any path and renders the
                 "We can't find that page" 404 (echoing the raw URI).
                 It was invisible for invites (scanned signed-out, where
                 the redirect-to-login masks the 404) but breaks vehicle
                 QRs (scanned signed-in by staff). Turn the framework
                 handler OFF so app_links is the single source of truth.
                 Supabase's OAuth callback has its own URI listener and
                 is unaffected by this flag. -->
            <meta-data
              android:name="flutter_deeplinking_enabled"
              android:value="false"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- Deep link for Supabase OAuth callback (Sign in with Google).
                 Matches redirectTo in lib/features/auth/login_screen.dart. -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="com.jardine.differentworld"
                      android:host="login-callback"/>
            </intent-filter>
            <!-- Invite deep links — custom scheme.
                 The QR + share-text use differentworld://invite/<code>.
                 Works today, no domain ownership required. -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="differentworld"
                      android:host="invite"/>
            </intent-filter>
            <!-- HTTPS fallback for invite links. autoVerify is false because
                 we don't host assetlinks.json at differentworld.app yet —
                 enabling autoVerify would have Android silently drop the
                 filter when verification fails. With autoVerify=false, a
                 tap on the https URL gives the user an "Open with" chooser
                 that includes our app. Promote to verified once the
                 domain + .well-known/assetlinks.json are wired. -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="https"
                      android:host="differentworld.app"
                      android:pathPrefix="/invite"/>
            </intent-filter>
            <!-- Vehicle checkout / checkin deep links — custom scheme.
                 QR codes printed for the dashboard / key fob encode
                 differentworld://v/<vehicleId>/checkout (or /checkin).
                 Works today on both Android and iOS without owning
                 the domain. -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="differentworld"
                      android:host="v"/>
            </intent-filter>
            <!-- HTTPS fallback for vehicle links. Same autoVerify=false
                 rationale as /invite above — promote to verified once
                 .well-known/assetlinks.json lands at differentworld.app.
                 Until then, scanning the https form gives an "Open with"
                 chooser; the custom scheme above is the reliable path. -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="https"
                      android:host="differentworld.app"
                      android:pathPrefix="/v"/>
            </intent-filter>
            <!-- Wave 170 — github.io project-page URLs while DNS for
                 differentworld.app is unresolved. The QR generator
                 encodes https://jardinefaner.github.io/differentworld-web/v/…
                 so Android shows the "Open with" chooser on scan.
                 Remove once we revert to the apex domain. -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="https"
                      android:host="jardinefaner.github.io"
                      android:pathPrefix="/differentworld-web/v"/>
            </intent-filter>
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="https"
                      android:host="jardinefaner.github.io"
                      android:pathPrefix="/differentworld-web/invite"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
