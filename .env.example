# Different World — environment template
# Copy this file to `.env` and fill in the values. `.env` is gitignored.
# These values are read at app startup via `flutter_dotenv`.
#
# Note on secrecy: the Supabase URL and anon key are PUBLIC by design — they
# ship inside the compiled app and anyone can extract them. Row-Level Security
# is what actually protects your data, not the key. Same for the PowerSync URL.
# Treat these as "configuration," not "secrets." Never put service_role keys,
# DB passwords, or API server secrets in this file or in the app.

# --- Supabase ------------------------------------------------------------
# Dashboard → your project → Settings → API
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# --- PowerSync -----------------------------------------------------------
# Dashboard → your instance → Instance URL
POWERSYNC_URL=https://YOUR-INSTANCE-ID.powersync.journeyapps.com

# --- Sentry (optional; leave blank to disable crash reporting) -----------
SENTRY_DSN=

# --- Deepgram (optional; leave blank to disable voice dictation) ---------
# Required for the omnibox mic button to stream speech-to-text via the
# Deepgram live transcription API. Use a project-scoped API key with
# usage limits configured — the key ships inside the compiled app, so
# treat it as semi-public (rate-limit + spend-cap upstream).
DEEPGRAM_API_KEY=
