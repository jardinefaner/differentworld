# Different World — environment template
# Copy this file to `.env` and fill in the values. `.env` is gitignored.
# These values are read at app startup via `flutter_dotenv`.
#
# Note on secrecy: the Supabase URL and anon key are PUBLIC by design — they
# ship inside the compiled app and anyone can extract them. Row-Level Security
# is what actually protects your data, not the key. Same for the PowerSync URL.
# Treat these as "configuration," not "secrets." Never put service_role keys,
# DB passwords, or API server secrets in this file or in the app.

# --- Supabase ------------------------------------------------------------
# Dashboard → your project → Settings → API
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# --- PowerSync -----------------------------------------------------------
# Dashboard → your instance → Instance URL
POWERSYNC_URL=https://YOUR-INSTANCE-ID.powersync.journeyapps.com

# --- Sentry (optional; leave blank to disable crash reporting) -----------
SENTRY_DSN=

# --- Deepgram (optional; leave blank to disable voice dictation) ---------
# Required for the omnibox mic button to stream speech-to-text via the
# Deepgram live transcription API. ⚠️  This key ends up inside the
# compiled app (APK / IPA) where any user can extract it. For pre-
# release / personal-dev use it's fine; before EXTERNAL rollout, move
# the key behind a Supabase Edge Function broker (see docs/SECRETS.md
# — uses Deepgram's `/v1/auth/grant` short-lived token endpoint so
# only the temp token, not the master key, lives in client memory).
# Until then, set strict usage limits + spending caps on this key in
# the Deepgram dashboard so any leak is bounded.
DEEPGRAM_API_KEY=

# --- OpenAI (optional; leave blank to disable AI features) ---------------
# Same security caveat as DEEPGRAM_API_KEY — this key ships inside the
# compiled app. For external rollout, broker through an Edge Function
# (proxy the chat-completions call server-side; client never sees the
# OpenAI key). Set per-key usage caps + project scoping in the OpenAI
# dashboard before shipping. Until the broker exists, keep this slot
# empty in CI / release builds.
OPENAI_API_KEY=
